# PostgreSQL connection (docker compose default)
DATABASE_URL=postgres://pack:pack@localhost:5432/pack

# File storage driver: "local" (disk) or "s3" (Cloudflare R2 / AWS S3)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./data/uploads

# Only required when STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=auto
# R2: https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Public URL, baked in at build time for CSRF checks on form posts (unset = derive from request)
ORIGIN=http://localhost:3000
# Max upload size accepted by the Node adapter (bytes)
BODY_SIZE_LIMIT=209715200
